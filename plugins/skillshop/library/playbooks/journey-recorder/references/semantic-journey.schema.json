{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Journey",
  "type": "object",
  "required": [
    "id",
    "goal",
    "actor",
    "preconditions",
    "steps",
    "assertions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "source": {
      "enum": [
        "human-recording",
        "agent-recording",
        "manual-authoring"
      ]
    },
    "environment": {
      "type": "object"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "test_id": {
                "type": "string"
              },
              "route": {
                "type": "string"
              },
              "domain_object": {
                "type": "string"
              }
            }
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "network": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dynamic_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}